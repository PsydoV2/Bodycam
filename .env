# Öffentliche Basis-URL der Seite (ohne Slash am Ende) — wird in index.html
# in die og:/twitter:-Tags eingesetzt (%VITE_SITE_URL%). Leer = relative
# URLs; für Social-Previews braucht es die absolute Domain. Lokal in
# .env.local überschreiben (gitignored), z. B.:
#   VITE_SITE_URL=https://bodycam.example.com
VITE_SITE_URL=
